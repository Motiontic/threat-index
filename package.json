{
  "name": "threat-index",
  "private": true,
  "version": "0.0.0",
  "description": "One record of every public vulnerability, exploit, breach and AI incident, refreshed every 3 hours on Cloudflare.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r --parallel --filter \"!@ti/web\" exec tsc --noEmit && pnpm --filter @ti/web typecheck",
    "test": "vitest run",
    "test:workers": "vitest run --config vitest.workers.config.mts && pnpm --filter @ti/web test:workers",
    "build": "pnpm lint && pnpm typecheck && pnpm test",
    "preview": "node scripts/preview.mjs",
    "deploy:staging": "node scripts/deploy.mjs staging",
    "deploy:production": "node scripts/deploy.mjs production"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@cloudflare/vitest-plugin": "^1.9.0",
    "@cloudflare/workers-types": "^5.20261119.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.0.0"
  }
}
