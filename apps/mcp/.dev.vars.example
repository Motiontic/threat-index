# Copy to .dev.vars (gitignored) for local runs in a loop sandbox. Never put real values in this file.
# Must match ti-api's values: ti-mcp signs the user's identity with them, ti-api checks it.
MCP_HMAC_SECRET=
# Optional: the next secret, set while rotating.
MCP_HMAC_SECRET_NEXT=
# Seals the requestState of an elicitation (AES-GCM). Not the HMAC secret. Any 32 random bytes, base64. Missing: elicitation is off.
MCP_STATE_KEY=
# Optional: the next key, set while rotating.
MCP_STATE_KEY_NEXT=
