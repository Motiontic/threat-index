itionalProperties":false}},"required":["asOf","credits","notes","found","id"],"additionalProperties":false}},{"name":"mti_list_sources","title":"List sources","description":"Lists the sources MTI collects from that have records: what each gives, how often it is collected, its licence status and its last successful collection.","inputSchema":{"type":"object","$schema":"https://json-schema.org/draft/2020-12/schema","properties":{},"additionalProperties":false},"annotations":{"title":"List sources","readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"asOf":{"type":"string","maxLength":40},"notes":{"type":"array","items":{"type":"string","maxLength":200},"maxItems":10},"sources":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string","maxLength":64},"name":{"type":["string","null"],"maxLength":200},"gives":{"type":["string","null"],"maxLength":600},"cadence":{"type":["string","null"],"maxLength":120},"licence":{"type":"string","enum":["on","ask","wait","link"]},"display":{"type":"string","enum":["full","link"]},"credit":{"type":["string","null"],"maxLength":600},"lastSuccess":{"type":"string","maxLength":40},"lastRunStatus":{"type":["string","null"],"maxLength":32}},"required":["id","name","gives","cadence","licence","display","credit","lastSuccess","lastRunStatus"],"additionalProperties":false},"maxItems":200}},"required":["asOf","notes","sources"],"additionalProperties":false}},{"name":"mti_watch_add","title":"Watch a package or entry","description":"Adds one package or one entry to the user's watchlist so MTI emails alerts about it. Takes an ecosystem and name, a purl (the version is ignored) or a CVE, GHSA, OSV, MAL or EUVD ID, one item at a time. A user can watch up to 200 packages. Returns whether the watch is new and whether email alerts are on. Changes the account's watchlist.","inputSchema":{"type":"obj