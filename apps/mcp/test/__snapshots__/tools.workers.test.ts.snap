exports[`off switch and tools/list > the list is the twelve tools in TOOL_ORDER order, with hints and cache hints on 2026-07-28 1`] = `"[{"name":"mti_check_packages","title":"Check packages","description":"Checks package versions against MTI records of known vulnerabilities, malicious packages and exploitation signals. Takes up to 20,000 packages or 3 MiB, each as ecosystem, name and version, or as a purl. Over 1,000 packages is answered as an MCP task, for clients that support tasks. Returns a priority per package (fix_now, fix_soon, plan or note), the version that fixes the matches where one is known, and the matching records. A package with no match is listed under noRecord, which means MTI has no record as of asOf, not that the package is safe. Reachability is not checked.","inputSchema":{"type":"object","$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"packages":{"type":"array","items":{"oneOf":[{"type":"object","properties":{"ecosystem":{"type":"string","enum":["npm","PyPI","Go","Maven","crates.io","RubyGems","NuGet","Packagist","Hex","Pub","SwiftURL","GitHub Actions","Debian","Ubuntu","Alpine","Red Hat"]},"name":{"type":"string","maxLength":214,"minLength":1},"version":{"type":"string","maxLength":128,"minLength":1}},"required":["ecosystem","name","version"],"additionalProperties":false},{"type":"object","properties":{"purl":{"type":"string","maxLength":512,"minLength":5,"pattern":"^pkg:"}},"required":["purl"],"additionalProperties":false}]},"maxItems":20000,"minItems":1},"cursor":{"type":"string","maxLength":512}},"required":[],"additionalProperties":false},"annotations":{"title":"Check packages","readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"asOf":{"type":"string","maxLength":40},"credits":{"type":"array","items":{"type":"object","properties":{"source":{"type":"string","maxLength":64},"text":