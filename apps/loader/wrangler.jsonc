// ti-loader: moves E2B output (R2 inbox/) into D1 within the daily write budget.
// Top level = production. `--env staging` = staging (worker ti-loader-staging, *_staging resources).
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ti-loader",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  // No HTTP handler: queue and cron events only, so no public workers.dev URL.
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB_CONTROL",
      "database_name": "ti_control",
      "migrations_dir": "../../packages/db/migrations/control"
    },
    {
      "binding": "DB_VULNS",
      "database_name": "ti_vulns",
      "migrations_dir": "../../packages/db/migrations/vulns"
    },
    {
      "binding": "DB_ADVISORIES",
      "database_name": "ti_advisories",
      "migrations_dir": "../../packages/db/migrations/advisories"
    },
    {
      "binding": "DB_SIGNALS",
      "database_name": "ti_signals",
      "migrations_dir": "../../packages/db/migrations/signals"
    },
    {
      "binding": "DB_WORLD",
      "database_name": "ti_world",
      "migrations_dir": "../../packages/db/migrations/world"
    }
  ],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "threat-index" }],
  "queues": {
    "producers": [{ "binding": "LOAD", "queue": "ti-load" }],
    // One chunk per invocation bounds the work. max_concurrency caps parallel D1 writers: deferred
    // chunks all wake just after midnight UTC.
    "consumers": [{ "queue": "ti-load", "max_batch_size": 1, "max_retries": 10, "max_concurrency": 5 }]
  },

  "env": {
    "staging": {
      "d1_databases": [
        {
          "binding": "DB_CONTROL",
          "database_name": "ti_control_staging",
          "migrations_dir": "../../packages/db/migrations/control"
        },
        {
          "binding": "DB_VULNS",
          "database_name": "ti_vulns_staging",
          "migrations_dir": "../../packages/db/migrations/vulns"
        },
        {
          "binding": "DB_ADVISORIES",
          "database_name": "ti_advisories_staging",
          "migrations_dir": "../../packages/db/migrations/advisories"
        },
        {
          "binding": "DB_SIGNALS",
          "database_name": "ti_signals_staging",
          "migrations_dir": "../../packages/db/migrations/signals"
        },
        {
          "binding": "DB_WORLD",
          "database_name": "ti_world_staging",
          "migrations_dir": "../../packages/db/migrations/world"
        }
      ],
      "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "threat-index-staging" }],
      "queues": {
        "producers": [{ "binding": "LOAD", "queue": "ti-load-staging" }],
        "consumers": [
          { "queue": "ti-load-staging", "max_batch_size": 1, "max_retries": 10, "max_concurrency": 5 }
        ]
      }
    }
  }
}
