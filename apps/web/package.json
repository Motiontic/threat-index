{
  "name": "@ti/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "The public MTI (Motiontic Threat Index) site: React Router 8 on Cloudflare Workers.",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "build": "react-router build",
    "dev": "echo 'Local servers are not run for this app from loops or laptops; use pnpm build and pnpm test:workers.' && exit 1",
    "typecheck": "react-router typegen && tsc --noEmit",
    "test:workers": "react-router build && node scripts/smoke.mjs"
  },
  "dependencies": {
    "@clerk/react-router": "3.6.42",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@ti/core": "workspace:*",
    "@ti/sources": "workspace:*",
    "isbot": "5.2.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.70.1",
    "@react-router/dev": "8.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "vite": "7.3.8"
  }
}
