// ti-web: the public site, React Router 8 server-rendered on Workers.
//
// Top level = production. `env.staging` = staging (worker ti-web-staging).
//
// The environment is chosen AT BUILD TIME, not at deploy time: `@cloudflare/vite-plugin` reads this file
// during `react-router build` and writes a flattened config for one environment to
// build/server/wrangler.json, plus a redirect to it in .wrangler/deploy/config.json.
//   pnpm --filter @ti/web build                          -> ti-web (production)
//   CLOUDFLARE_ENV=staging pnpm --filter @ti/web build   -> ti-web-staging
// Deploy with `wrangler deploy -c <that built config>`. Never pass `--env` to wrangler for this app;
// scripts/deploy.mjs and apps/web/scripts/deploy-web.mjs do this and refuse a build for the wrong environment.
// This file has no placeholder values, so scripts/wrangler-config.mjs has nothing to fill.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ti-web",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": { "TI_ENV": "production", "DATA_SOURCE": "api" },
  // Production is served at https://mti.motiontic.com (Cloudflare creates the DNS record and certificate; the
  // zone must be on this account). Staging keeps its workers.dev address. The site URL itself (SITE_ORIGIN) is
  // a var set at deploy by scripts/deploy-web.mjs (`--var`, from TI_APP_URL / TI_APP_URL_STAGING).
  "routes": [{ "pattern": "mti.motiontic.com", "custom_domain": true }],
  // Clerk (sign-in). No key values live here:
  //   CLERK_PUBLISHABLE_KEY  a plain var (public), set at deploy by scripts/deploy-web.mjs (`--var`).
  //   CLERK_SECRET_KEY       a Worker secret: `wrangler secret put CLERK_SECRET_KEY --name ti-web[-staging]`.
  // Without both, Clerk is off: every page renders signed out and sign-in says it is unavailable.
  // Never add an AUTH_MODE var here: fake sign-in is for local fixtures runs only (deploy refuses it).
  // Loaders call ti-api through this binding (app/data/api.server.ts).
  "services": [{ "binding": "API", "service": "ti-api" }],
  // Page rate limit (per Cloudflare location, approximate). Not inherited by env.staging.
  "ratelimits": [{ "name": "RL_PAGES", "namespace_id": "7104", "simple": { "limit": 120, "period": 60 } }],
  // More secrets and vars:
  //   EDGE_HMAC_SECRET  a Worker secret, the same value as ti-api's: `wrangler secret put EDGE_HMAC_SECRET --name ti-web[-staging]`.
  //   ADMIN_USER_IDS    a plain var set at deploy by scripts/deploy-web.mjs (`--var`, from TI_ADMIN_USER_IDS).

  "env": {
    "staging": {
      "name": "ti-web-staging",
      "vars": { "TI_ENV": "staging", "DATA_SOURCE": "api" },
      // Staging keeps workers.dev only: no custom domain (explicit, so it can never inherit production's).
      "routes": [],
      "services": [{ "binding": "API", "service": "ti-api-staging" }],
      "ratelimits": [{ "name": "RL_PAGES", "namespace_id": "7204", "simple": { "limit": 120, "period": 60 } }]
    }
  }
}
