// ti-api: Hono JSON API, Clerk auth (single-user), webhooks, E2B job callbacks.
// This config also lists every D1 database with its migrations folder, so
// `pnpm --filter @ti/db migrate:local` can apply all migrations from here.
//
// Top level = production. `--env staging` = staging (worker ti-api-staging, *_staging resources).
// D1, R2 and Queues are found by name. ${VAR} values are filled in by scripts/wrangler-config.mjs
// before a deploy, so account-specific IDs never live in this public file.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ti-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB_CONTROL",
      "database_name": "ti_control",
      "migrations_dir": "../../packages/db/migrations/control"
    },
    {
      "binding": "DB_VULNS",
      "database_name": "ti_vulns",
      "migrations_dir": "../../packages/db/migrations/vulns"
    },
    {
      "binding": "DB_ADVISORIES",
      "database_name": "ti_advisories",
      "migrations_dir": "../../packages/db/migrations/advisories"
    },
    {
      "binding": "DB_SIGNALS",
      "database_name": "ti_signals",
      "migrations_dir": "../../packages/db/migrations/signals"
    },
    {
      "binding": "DB_WORLD",
      "database_name": "ti_world",
      "migrations_dir": "../../packages/db/migrations/world"
    },
    {
      "binding": "DB_USERS",
      "database_name": "ti_users",
      "migrations_dir": "../../packages/db/migrations/users"
    }
  ],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "threat-index" }],
  "kv_namespaces": [{ "binding": "SETTINGS", "id": "${TI_SETTINGS_KV_ID}" }],
  "queues": {
    // JOBS and JOBS_DLQ are read-only here: the /ops page calls metrics() on them.
    "producers": [
      { "binding": "LOAD", "queue": "ti-load" },
      { "binding": "JOBS", "queue": "ti-jobs" },
      { "binding": "JOBS_DLQ", "queue": "ti-jobs-dlq" }
    ]
  },
  // Rate limits (per Cloudflare location, approximate). Not inherited by env.staging, which has its own
  // namespace ids so staging never shares production counters.
  "ratelimits": [
    { "name": "RL_PUBLIC", "namespace_id": "7101", "simple": { "limit": 120, "period": 60 } },
    { "name": "RL_USER", "namespace_id": "7102", "simple": { "limit": 240, "period": 60 } },
    { "name": "RL_DEEP", "namespace_id": "7103", "simple": { "limit": 5, "period": 60 } }
  ],
  "vars": {
    "CLERK_PUBLISHABLE_KEY": "<pk_live_or_pk_test>",
    "ADMIN_USER_IDS": "${TI_ADMIN_USER_IDS?}",
    "API_BASE": "${TI_API_URL}",
    "E2B_TEMPLATE": "threat-index-jobs",
    "R2_BUCKET_NAME": "threat-index",
    "SITE_ORIGIN": "${TI_APP_URL?}"
  },
  // Secrets: CLERK_SECRET_KEY, CLERK_WEBHOOK_SIGNING_SECRET, RESEND_WEBHOOK_SECRET,
  // UNSUBSCRIBE_SECRET, JOB_HMAC_SECRET, EDGE_HMAC_SECRET (same value as ti-web's), R2_ACCOUNT_ID, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, E2B_API_KEY

  "env": {
    "staging": {
      // Per-branch preview URLs (`pnpm preview`) let loops test here instead of on a laptop.
      "preview_urls": true,
      "d1_databases": [
        {
          "binding": "DB_CONTROL",
          "database_name": "ti_control_staging",
          "migrations_dir": "../../packages/db/migrations/control"
        },
        {
          "binding": "DB_VULNS",
          "database_name": "ti_vulns_staging",
          "migrations_dir": "../../packages/db/migrations/vulns"
        },
        {
          "binding": "DB_ADVISORIES",
          "database_name": "ti_advisories_staging",
          "migrations_dir": "../../packages/db/migrations/advisories"
        },
        {
          "binding": "DB_SIGNALS",
          "database_name": "ti_signals_staging",
          "migrations_dir": "../../packages/db/migrations/signals"
        },
        {
          "binding": "DB_WORLD",
          "database_name": "ti_world_staging",
          "migrations_dir": "../../packages/db/migrations/world"
        },
        {
          "binding": "DB_USERS",
          "database_name": "ti_users_staging",
          "migrations_dir": "../../packages/db/migrations/users"
        }
      ],
      "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "threat-index-staging" }],
      "kv_namespaces": [{ "binding": "SETTINGS", "id": "${TI_SETTINGS_KV_ID_STAGING}" }],
      "queues": {
        "producers": [
          { "binding": "LOAD", "queue": "ti-load-staging" },
          { "binding": "JOBS", "queue": "ti-jobs-staging" },
          { "binding": "JOBS_DLQ", "queue": "ti-jobs-dlq-staging" }
        ]
      },
      "ratelimits": [
        { "name": "RL_PUBLIC", "namespace_id": "7201", "simple": { "limit": 120, "period": 60 } },
        { "name": "RL_USER", "namespace_id": "7202", "simple": { "limit": 240, "period": 60 } },
        { "name": "RL_DEEP", "namespace_id": "7203", "simple": { "limit": 5, "period": 60 } }
      ],
      // CLERK_PUBLISHABLE_KEY is a secret here (Clerk development instance), not a var.
      "vars": {
        "ADMIN_USER_IDS": "${TI_ADMIN_USER_IDS?}",
        "API_BASE": "${TI_API_URL_STAGING}",
        "E2B_TEMPLATE": "threat-index-jobs-staging",
        "R2_BUCKET_NAME": "threat-index-staging",
        "SITE_ORIGIN": "${TI_APP_URL_STAGING?}"
      }
    }
  }
}
