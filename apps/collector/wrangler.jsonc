// ti-collector: cron planner, ti-jobs consumer (one pull step per message), ti-jobs-dlq consumer
// (records dead-lettered steps) and the daily watchdog report.
// Top level = production. `--env staging` = staging (worker ti-collector-staging, *_staging resources).
// D1, R2 and Queues are found by name. ${VAR} values are filled in by scripts/wrangler-config.mjs;
// ${VAR?} is optional: when unset, the binding or var that uses it is left out.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ti-collector",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // No HTTP handler: queue and cron events only, so no public workers.dev URL.
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    // every 3 h · daily after EPSS · nightly fold · weekly (staging inherits the same schedule)
    "crons": ["0 */3 * * *", "45 14 * * *", "30 2 * * *", "0 5 * * 1"]
  },
  "d1_databases": [
    { "binding": "DB_CONTROL", "database_name": "ti_control" },
    { "binding": "DB_VULNS", "database_name": "ti_vulns" },
    { "binding": "DB_ADVISORIES", "database_name": "ti_advisories" },
    { "binding": "DB_SIGNALS", "database_name": "ti_signals" },
    { "binding": "DB_WORLD", "database_name": "ti_world" }
  ],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "threat-index" }],
  "kv_namespaces": [{ "binding": "SETTINGS", "id": "${TI_SETTINGS_KV_ID}" }],
  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "ti-jobs" }, { "binding": "NOTIFY", "queue": "ti-notify" }],
    "consumers": [
      { "queue": "ti-jobs", "max_batch_size": 5, "max_retries": 5, "dead_letter_queue": "ti-jobs-dlq" },
      // Steps that ran out of retries land here; recordDeadLetters marks their runs failed.
      { "queue": "ti-jobs-dlq", "max_batch_size": 10, "max_retries": 3 }
    ]
  },
  // ti-api starts E2B jobs for big files (POST /internal/jobs, signed with JOB_HMAC_SECRET).
  "services": [{ "binding": "API", "service": "ti-api" }],
  // The daily watchdog report goes only to one address verified in Email Routing. Without
  // TI_OPS_EMAIL the binding is left out and the report is only logged.
  "send_email": [{ "name": "OPS_EMAIL", "destination_address": "${TI_OPS_EMAIL?}" }],
  "vars": {
    // TI_OPS_EMAIL_FROM: an address on the Email Routing domain. TI_CONTACT_EMAIL is only the contact shown
    // in the User-Agent; it adds no email binding, so it can be set without Email Routing.
    "OPS_EMAIL_TO": "${TI_OPS_EMAIL?}",
    "OPS_EMAIL_FROM": "${TI_OPS_EMAIL_FROM?}",
    "USER_AGENT": "ThreatIndex/0.1 (+https://github.com/Motiontic/threat-index; ${TI_CONTACT_EMAIL?})",
    // Contact for sources that ask for one (SEC EDGAR gets `Motiontic Threat Index <contact>`). Without it SEC is skipped.
    "CONTACT_EMAIL": "${TI_CONTACT_EMAIL?}"
  },
  // Secrets (wrangler secret put): JOB_HMAC_SECRET (signs calls to ti-api; the same value ti-api holds),
  // GITHUB_TOKEN and NVD_API_KEY (optional, passed to patterns that need them), GITLAB_TOKEN, E2B_API_KEY,
  // R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY

  "env": {
    "staging": {
      "d1_databases": [
        { "binding": "DB_CONTROL", "database_name": "ti_control_staging" },
        { "binding": "DB_VULNS", "database_name": "ti_vulns_staging" },
        { "binding": "DB_ADVISORIES", "database_name": "ti_advisories_staging" },
        { "binding": "DB_SIGNALS", "database_name": "ti_signals_staging" },
        { "binding": "DB_WORLD", "database_name": "ti_world_staging" }
      ],
      "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "threat-index-staging" }],
      "kv_namespaces": [{ "binding": "SETTINGS", "id": "${TI_SETTINGS_KV_ID_STAGING}" }],
      "queues": {
        "producers": [
          { "binding": "JOBS", "queue": "ti-jobs-staging" },
          { "binding": "NOTIFY", "queue": "ti-notify-staging" }
        ],
        "consumers": [
          {
            "queue": "ti-jobs-staging",
            "max_batch_size": 5,
            "max_retries": 5,
            "dead_letter_queue": "ti-jobs-dlq-staging"
          },
          { "queue": "ti-jobs-dlq-staging", "max_batch_size": 10, "max_retries": 3 }
        ]
      },
      // Bindings don't inherit into env.staging, so the service is named again.
      "services": [{ "binding": "API", "service": "ti-api-staging" }],
      // No ops email from staging. TI_CONTACT_EMAIL is the contact in the User-Agent (SEC asks for one);
      // without it the key is dropped and the default User-Agent is used.
      "vars": {
        "USER_AGENT": "ThreatIndex-staging/0.1 (+https://github.com/Motiontic/threat-index; ${TI_CONTACT_EMAIL?})",
        "CONTACT_EMAIL": "${TI_CONTACT_EMAIL?}"
      }
    }
  }
}
